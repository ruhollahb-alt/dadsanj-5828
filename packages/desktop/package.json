{
  "name": "@template/desktop",
  "private": true,
  "version": "1.2.0",
  "description": "DadSanj — Iranian delayed-payment damages calculator",
  "author": "DadSanj",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dist": "bun run prepare-web && vite build && electron-builder",
    "prepare-web": "bun ../web/node_modules/vite/bin/vite.js build ../web --config ../web/vite.config.ts --mode desktop && bun scripts/copy-web.ts",
    "dist:win": "bun run prepare-web && vite build && electron-builder --win nsis --x64",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@runablehq/managed-auth": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "typescript": "7.0.1-rc",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
